{
  "name": "@xiaoqiong0v0/opencode-emotions",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode 插件：用极短符号/命令表达情绪，归一化为 emoji(等级/3) 标注写回消息。",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/emotions.js",
  "exports": {
    ".": "./dist/emotions.js",
    "./tui": "./dist/tui.js"
  },
  "bin": {
    "voice-cli": "./dist/cli/voice-cli.js"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc && node scripts/build-tui.mjs",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "voice": "node dist/runtime/voice-runtime.js",
    "voice-cli": "node dist/cli/voice-cli.js",
    "publish:proj": "npm run build && node scripts/publish-proj.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "emotions"
  ],
  "license": "MIT",
  "dependencies": {
    "@xiaoqiong0v0/opencode-plugin-logger": "^1.0.5",
    "ffmpeg-static": "^5.3.0",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "babel-preset-solid": "^1.9.12",
    "typescript": "^5.7.0"
  }
}

{
  "name": "@xiaoqiong0v0/opencode-emotions",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode plugin: emotion-aware voice I/O — realtime speech-to-text with emotion tagging, plus text-to-speech output.",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/emotions.js",
  "exports": {
    ".": "./dist/emotions.js",
    "./tui": "./dist/tui.js"
  },
  "bin": {
    "emotions-cli": "./dist/cli/emotions-cli.js"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc && node scripts/build-tui.mjs",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "voice": "node dist/runtime/voice-runtime.js",
    "emotions-cli": "node dist/cli/emotions-cli.js",
    "publish:proj": "npm run build && node scripts/publish-proj.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "emotions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoqiong0v0/opencode-emotions.git"
  },
  "homepage": "https://github.com/xiaoqiong0v0/opencode-emotions#readme",
  "bugs": {
    "url": "https://github.com/xiaoqiong0v0/opencode-emotions/issues"
  },
  "dependencies": {
    "@xiaoqiong0v0/opencode-plugin-logger": "^1.0.5",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "babel-preset-solid": "^1.9.12",
    "typescript": "^5.7.0"
  }
}
